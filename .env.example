# TWP-Gen runtime configuration
# Copy this file to .env and fill values locally. Do not commit real secrets.

# Where the central settings live. Copy twpgen_config.example.json to
# twpgen_config.json at the repository root and keep your edits there.
TWPGEN_CONFIG=./twpgen_config.json
TWPGEN_DATASET=topic
TWPGEN_DATASET_ROOT=./dataset
TWPGEN_RESOURCE_DIR=./resources
TWPGEN_OUTPUT_DIR=./output
TWPGEN_GPU_IDS=0,1
TWPGEN_LLM_MODEL=

# Optional external APIs, only required by integrations that call hosted services.
OPENAI_API_KEY=
OPENAI_BASE_URL=
TAVILY_API_KEY=

# Information collection stage
TWPGEN_SEARCH_ROOT=./knowledge_collector
TWPGEN_TOPIC_FILE=./knowledge_collector/topic.txt
TWPGEN_COLLECTOR_RESULT_DIR=./knowledge_collector/result
TWPGEN_SEARCH_TOP_N=10
TWPGEN_GOOGLE_ALERTS_API_URL=http://localhost:5000

# LLM and search credentials. Keep real values in .env, not in source control.
OPENAI_API_KEY=
OPENAI_BASE_URL=
TWPGEN_LLM_MODEL=qwen3-max
TAVILY_API_KEY=
# TAVILY_API_KEYS can contain multiple keys separated by commas, semicolons, or newlines.
TAVILY_API_KEYS=
# Optional: path to a file with one Tavily key per line.
TWPGEN_TAVILY_KEY_FILE=
# Folder layout
TWPGEN_KNOWLEDGE_ROOT=./knowledge_collector
TWPGEN_OUTLINE_ROOT=./outline_generator
TWPGEN_ARTICLE_ROOT=./article_generator
TWPGEN_ARTICLE_ENV=
# Article generation LLM overrides. If empty, OPENAI_* and TWPGEN_LLM_MODEL are used.
ARTICLE_LLM_API_KEY=
ARTICLE_LLM_BASE_URL=
ARTICLE_LLM_MODEL=
ARTICLE_ENABLE_THINKING=false
