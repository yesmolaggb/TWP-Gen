{
  "project_name": "TWP-Gen",
  "paper_title": "Technical White Paper Generation via Multidimensional Feature Fusion",
  "dataset_name": "topic",
  "dataset_root": "./dataset",
  "resource_dir": "./resources",
  "output_dir": "./output",
  "spacy_model": "zh_core_web_lg",
  "language_model": "chinese-bert-wwm",
  "gpu_ids": [
    0,
    1
  ],
  "feature_fusion": {
    "min_verb_freq": 3,
    "top_verb_ratio": 0.8,
    "min_obj_freq": 3,
    "top_obj_ratio": 0.8,
    "top_k_expand_result": 50
  },
  "graph_model": {
    "name": "GAE",
    "input_dim": 768,
    "hidden1_dim": 512,
    "hidden2_dim": 256,
    "num_epoch": 100,
    "learning_rate": 0.001
  },
  "external_services": {
    "openai_api_key_env": "OPENAI_API_KEY",
    "openai_base_url_env": "OPENAI_BASE_URL",
    "tavily_api_key_env": "TAVILY_API_KEY"
  }
}