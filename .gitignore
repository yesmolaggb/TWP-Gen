# Runtime data and generated state
# NOTE: /dataset/ is the pipeline's runtime root, but it also holds the committed
# evaluation resources (task list + code), so those paths are re-included below.
/dataset/*
!/dataset/README.md
!/dataset/README.zh-CN.md
!/dataset/whitepaper_topics.json
!/dataset/whitepaper_topics.txt
!/dataset/evaluation/
/logs/
/output/
/resources/
/.pipeline_state/
/.pipeline_locks/

# Large generated artifacts
*.pk
*.pkl
*.pt
*.pth
*.bin
*.cache

# Secrets
.env
*.key
*.pem

# Python
__pycache__/
*.py[cod]
.venv/

# Runtime collection outputs and local secrets
/information_collector/result/
/information_collector/config/
/logs/
/.pipeline_state/
/.pipeline_locks/
.env

/knowledge_collector/result/

# Local runtime configuration (copy twpgen_config.example.json instead)
/twpgen_config.json
